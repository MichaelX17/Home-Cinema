# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ============ HOME CINEMA - PELÍCULAS ============
# Ignorar todo el contenido de la carpeta movies, pero mantener la estructura
/public/movies/**
!/public/movies/
!/public/movies/*/.gitkeep

# OPCIÓN ALTERNATIVA - Más específica (recomendada):
# Ignorar archivos multimedia y datos, pero permitir estructura
/public/movies/**/*.mp4
/public/movies/**/*.mkv
/public/movies/**/*.avi
/public/movies/**/*.mov
/public/movies/**/*.webm
/public/movies/**/*.jpg
/public/movies/**/*.jpeg
/public/movies/**/*.png
/public/movies/**/*.webp
/public/movies/**/*.json